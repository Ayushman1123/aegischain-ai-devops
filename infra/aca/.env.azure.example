# Backend runtime
JWT_SECRET=replace-with-strong-secret
PORT=8787
CORS_ORIGIN=https://your-frontend-domain

# Optional: Enable managed cloud persistence mirror in Cosmos
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
AZURE_COSMOS_KEY=replace-with-cosmos-key
AZURE_COSMOS_DATABASE=aegischain

# Frontend (Spark/Vite)
VITE_API_BASE_URL=https://your-aca-fqdn
