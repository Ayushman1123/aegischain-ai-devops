# Backend Environment - Production (copy from .env.azure.example and customize)
NODE_ENV=production
PORT=8787
CORS_ORIGIN=https://your-frontend-domain.com
JWT_SECRET=your-very-long-random-secret-key-change-in-production

# Database
DB_PATH=/data/aegischain.db

# Azure Cosmos DB (optional - for cloud persistence)
# Uncomment and configure if deploying to Azure
# AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# AZURE_COSMOS_KEY=your-cosmos-key
# AZURE_COSMOS_DATABASE=aegischain

# Logging
LOG_LEVEL=info
